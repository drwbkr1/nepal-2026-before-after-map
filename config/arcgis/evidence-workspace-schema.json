  "map_name": "Evidence Workspace",
  "layout_name": "Evidence Workspace Overview",
  "principles": [
    "Direct satellite observations are stored separately from analyst interpretations and event attribution assessments.",
    "Source identity and observation-to-source joins are explicit and many-to-many.",
    "Failed, rejected, invalid, superseded, deferred, and inconclusive states remain representable.",
    "Exclusions and registration controls are first-class evidence rather than hidden processing state.",
    "Empty scientific layers do not imply absence of change; they mean no reviewed observation has been admitted."
  ],
  "domains": {
    "DOM_RECORD_STATUS": {
      "field_type": "TEXT",
      "description": "Evidence record lifecycle status",
      "coded_values": {
